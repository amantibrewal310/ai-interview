meta {
  name: Update bookmark
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/bookmarks/{{bookmarkId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "url": "https://example.com/a2",
    "title": "Article A (renamed)",
    "description": ""
  }
}

vars:pre-request {
  baseUrl: http://127.0.0.1:5000
  bookmarkId: 1
}
